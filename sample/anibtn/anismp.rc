#include <os2.h>
#include "anismp.h"

BITMAP BMP_ABT_UP "ABT_UP.BMP"
BITMAP BMP_ABT_DN "ABT_DN.BMP"
BITMAP BMP_NXT_UP "NXT_UP.BMP"
BITMAP BMP_NXT_DN "NXT_DN.BMP"
BITMAP BMP_LST_UP "LST_UP.BMP"
BITMAP BMP_LST_DN "LST_DN.BMP"
BITMAP BMP_INF_UP "INF_UP.BMP"
BITMAP BMP_INF_DN "INF_DN.BMP"
BITMAP BMP_EXT_UP "EXT_UP.BMP"
BITMAP BMP_EXT_DN "EXT_DN.BMP"
BITMAP BMP_NA_UP  "NA_UP.BMP"
BITMAP BMP_NA_DN  "NA_DN.BMP"

DLGTEMPLATE DLG_TOOLBAR LOADONCALL MOVEABLE DISCARDABLE
BEGIN
    DIALOG  "AniButtn Test", DLG_TOOLBAR, 0, 0, 440, 44, NOT WS_VISIBLE,
            FCF_SYSMENU | FCF_TITLEBAR | FCF_MINMAX
    BEGIN
        CONTROL  "", TBB_FILE, 5,   19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_NEW,  40,  19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_EXIT, 75,  19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_NEXT, 110, 19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_LAST, 145, 19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_NA1,  180, 19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_NA2,  215, 19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_NA3,  250, 19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_NA4,  285, 19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_NA5,  320, 19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_NA6,  355, 19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        CONTROL  "", TBB_NA7,  390, 19, 34, 14, WC_BUTTON, BS_USERBUTTON | WS_VISIBLE
        LTEXT    "Move the pointer over a button.", TX_HELP, 6, 3, 428, 16, DT_WORDBREAK
    END
END
