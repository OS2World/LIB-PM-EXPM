; EXPM - Extended Presentation Manager library
; Module definition for EXPM.DLL.
;
; The import library lib\EXPM.LIB is generated by wlink as a side
; effect of the DLL link step (OPTION IMPLIB); this file documents the
; export list for other toolchains and tools.

LIBRARY EXPM
DESCRIPTION 'EXPM extended PM controls library, LGPLv3'
PROTMODE
CODE LOADONCALL
HEAPSIZE    4096
STACKSIZE   8192

EXPORTS
    XpmInitComboBox
    XpmInitComboBoxFromRes
    XpmCellInit
    XpmCreateCell
    XpmCellWindowFromID
    XpmCellParentWindowFromID
    XpmCreateToolbar
    XpmGenResIDStr
    XpmQueryCellSplit
    XpmSetCellSplit
    XpmQueryCellSplitType
    XpmSetCellSplitType
    XpmShowCell
    XpmCtlInit
    XpmCtlTerminate
    XpmCtlVersion
    XpmEditColorDlg
    XpmCreateAniButton
    XpmDeleteAniButton
    XpmShadeBtnInit
    XpmShadeBtnQueryVersion
    XpmDrawArrowHead
    XpmInitLBWidthHeight
    XpmDrawLBItems
    XpmQueryPresColors
    XpmStorePresParams
    XpmDrawBitmap
    XpmControlsInit
    XpmGetVersion
    XpmGetComponentVersion
    XpmStatusInit
    XpmProgressBarInit
    XpmWinButtonInit
