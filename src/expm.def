; EXPM - Extended Presentation Manager library
; Module definition for EXPM.DLL.
;
; The import library lib\EXPM.LIB is generated by wlink as a side
; effect of the DLL link step (OPTION IMPLIB); this file documents the
; export list for other toolchains and tools.

LIBRARY EXPM
DESCRIPTION 'EXPM extended PM controls library, LGPLv3'
PROTMODE
CODE LOADONCALL
HEAPSIZE    4096
STACKSIZE   8192

EXPORTS
    WinInitComboBox
    WinInitComboBoxFromRes
    WinCellInit
    WinCreateCell
    WinCellWindowFromID
    WinCellParentWindowFromID
    WinCreateToolbar
    WinGenResIDStr
    WinQueryCellSplit
    WinSetCellSplit
    WinQueryCellSplitType
    WinSetCellSplitType
    WinShowCell
    WinCtlInit
    WinCtlTerminate
    WinCtlVersion
    WinEditColorDlg
    WinCreateAniButton
    WinDeleteAniButton
    WinShadeBtnInit
    WinShadeBtnQueryVersion
