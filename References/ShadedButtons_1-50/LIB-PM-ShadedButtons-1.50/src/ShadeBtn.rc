#define INCL_WIN
#include <os2.h>
#include "ShadeRes.h"

/* Pointer resources extracted from the original dll\ShadeBtn.dll.
 * Each .ptr file contains an OS/2 native pointer (CI-format, 16x16 colour
 * with mono AND mask) as it was stored in the original compiled DLL.
 */
POINTER IDP_RADIOUP      "RadioUp.ptr"
POINTER IDP_RADIOUPSEL   "RadioUpSel.ptr"
POINTER IDP_RADIODOWN    "RadioDown.ptr"
POINTER IDP_RADIODOWNSEL "RadioDownSel.ptr"
POINTER IDP_CHECKUP      "CheckUp.ptr"
POINTER IDP_CHECKUPSEL   "CheckUpSel.ptr"
POINTER IDP_CHECKDOWN    "CheckDown.ptr"
POINTER IDP_CHECKDOWNSEL "CheckDownSel.ptr"
POINTER IDP_3STATEUP     "3StateUp.ptr"
POINTER IDP_3STATEDOWN   "3StateDown.ptr"
