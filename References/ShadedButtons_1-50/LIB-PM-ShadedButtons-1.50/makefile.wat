# makefile.wat -- OpenWatcom wmake build for ShadedButtons_1-15
# Target: 32-bit OS/2 (ArcaOS / Warp 4 flat model)
#
# Builds (in dependency order):
#   dll\ShadeBtn.dll  -- main shaded button DLL
#   lib\ShadeBtn.lib  -- OW import library (side effect of ShadeBtn.dll link)
#   dll\ShBtn.dll     -- PMCX wrapper DLL
#   sample\Test1\Test1.exe
#   sample\Test2\Test2.exe
#   sample\Test3\Test3.exe
#
# Requires PMCX SDK header (pmcx.h) to be findable on the include path.
# If it is not under h\ or src\, add -i=<path> to CFLAGS_DLL below.
#
# Usage:
#   wmake -f makefile.wat           # build everything
#   wmake -f makefile.wat clean     # remove generated files

CXX = wpp386
CC  = wcc386

# -bt=os2  target OS/2 32-bit protected mode
# -zp1     1-byte struct packing (matches original -Zp)
# -w3      warning level 3
# -d__OS2__ explicit OS/2 guard macro
# -bd      DLL mode (defines __SW_BD; used only for DLL targets)
CFLAGS_BASE = -bt=os2 -zp1 -w3 -d__OS2__
CFLAGS_DLL  = $(CFLAGS_BASE) -bd -i=h -i=src
CFLAGS_EXE  = $(CFLAGS_BASE)

OBJ = obj
DLL = dll

.BEFORE
    -mkdir $(OBJ) 2>NUL
    -mkdir $(DLL) 2>NUL
    -mkdir lib 2>NUL

all: dll\ShadeBtn.dll dll\ShBtn.dll sample\Test1\Test1.exe sample\Test2\Test2.exe sample\Test3\Test3.exe .SYMBOLIC

# -----------------------------------------------------------------------
# ShadeBtn.dll -- main shaded button window class DLL
#
# wrc searches for binary resource files (.ptr) relative to the rc file's
# directory; -i=src covers ShadeRes.h and acts as a fallback for the .ptr
# files when wrc resolves them from the working directory.
# option implib generates lib\ShadeBtn.lib as a side effect of the link.
# -----------------------------------------------------------------------

$(OBJ)\shadebtn.obj: src\shadebtn.cpp h\shadebtn.h src\ShadeRes.h
    $(CXX) $(CFLAGS_DLL) -fo=$@ src\shadebtn.cpp

$(OBJ)\ShadeBtn.res: src\ShadeBtn.rc src\ShadeRes.h
    wrc -r -bt=os2 -i=h -i=src src\ShadeBtn.rc -fo=$@

dll\ShadeBtn.dll: $(OBJ)\shadebtn.obj $(OBJ)\ShadeBtn.res
    wlink &
        system os2v2 dll initinstance terminstance &
        name $(DLL)\ShadeBtn.dll &
        option modname=SHADEBTN &
        file $(OBJ)\shadebtn.obj &
        export shBtnInit &
        export shBtnQueryVersion &
        option implib=lib\ShadeBtn.lib &
        option map=$(DLL)\ShadeBtn.map
    wrc $(OBJ)\ShadeBtn.res $(DLL)\ShadeBtn.dll

# -----------------------------------------------------------------------
# ShBtn.dll -- PMCX wrapper DLL
# Links against lib\ShadeBtn.lib (generated by the ShadeBtn.dll target).
# -----------------------------------------------------------------------

$(OBJ)\shbtn.obj: src\shbtn.cpp h\shadebtn.h h\ShBtn.H
    $(CXX) $(CFLAGS_DLL) -fo=$@ src\shbtn.cpp

$(OBJ)\ShBtn.res: src\ShBtn.rc h\ShBtn.H
    wrc -r -bt=os2 -i=h -i=src src\ShBtn.rc -fo=$@

dll\ShBtn.dll: $(OBJ)\shbtn.obj $(OBJ)\ShBtn.res lib\ShadeBtn.lib
    wlink &
        system os2v2 dll initinstance terminstance &
        name $(DLL)\ShBtn.dll &
        file $(OBJ)\shbtn.obj &
        export ShBtnRegister &
        export ShBtnQuery &
        export ShBtnStyles &
        library lib\ShadeBtn.lib &
        option map=$(DLL)\ShBtn.map
    wrc $(OBJ)\ShBtn.res $(DLL)\ShBtn.dll

# -----------------------------------------------------------------------
# Sample Test1 -- C++ PM application
# -----------------------------------------------------------------------

$(OBJ)\test1.obj: sample\Test1\test1.cpp h\shadebtn.h sample\Test1\test1.h
    $(CXX) $(CFLAGS_EXE) -i=sample\Test1 -fo=$@ sample\Test1\test1.cpp

$(OBJ)\Test1.res: sample\Test1\test1.rc sample\Test1\test1.h
    wrc -r -bt=os2 -i=sample\Test1 sample\Test1\test1.rc -fo=$@

sample\Test1\Test1.exe: $(OBJ)\test1.obj $(OBJ)\Test1.res
    wlink &
        system os2v2_pm &
        name sample\Test1\Test1.exe &
        file $(OBJ)\test1.obj &
        library lib\ShadeBtn.lib &
        option stack=65536 &
        option map=sample\Test1\Test1.map
    wrc $(OBJ)\Test1.res sample\Test1\Test1.exe

# -----------------------------------------------------------------------
# Sample Test2 -- C++ PM application
# -----------------------------------------------------------------------

$(OBJ)\test2.obj: sample\Test2\test2.cpp h\shadebtn.h sample\Test2\Test2.h
    $(CXX) $(CFLAGS_EXE) -i=sample\Test2 -fo=$@ sample\Test2\test2.cpp

$(OBJ)\Test2.res: sample\Test2\test2.rc sample\Test2\Test2.h
    wrc -r -bt=os2 -i=sample\Test2 sample\Test2\test2.rc -fo=$@

sample\Test2\Test2.exe: $(OBJ)\test2.obj $(OBJ)\Test2.res
    wlink &
        system os2v2_pm &
        name sample\Test2\Test2.exe &
        file $(OBJ)\test2.obj &
        library lib\ShadeBtn.lib &
        option stack=65536 &
        option map=sample\Test2\Test2.map
    wrc $(OBJ)\Test2.res sample\Test2\Test2.exe

# -----------------------------------------------------------------------
# Sample Test3 -- C PM application (plain C, compiled with wcc386)
# -----------------------------------------------------------------------

$(OBJ)\test3.obj: sample\Test3\test3.c h\shadebtn.h sample\Test3\test3.h
    $(CC) $(CFLAGS_EXE) -i=sample\Test3 -fo=$@ sample\Test3\test3.c

$(OBJ)\Test3.res: sample\Test3\Test3.Rc sample\Test3\test3.h
    wrc -r -bt=os2 -i=sample\Test3 sample\Test3\Test3.Rc -fo=$@

sample\Test3\Test3.exe: $(OBJ)\test3.obj $(OBJ)\Test3.res
    wlink &
        system os2v2_pm &
        name sample\Test3\Test3.exe &
        file $(OBJ)\test3.obj &
        library lib\ShadeBtn.lib &
        option stack=65536 &
        option map=sample\Test3\Test3.map
    wrc $(OBJ)\Test3.res sample\Test3\Test3.exe

# -----------------------------------------------------------------------
# Clean
# -----------------------------------------------------------------------

clean: .SYMBOLIC
    -rm -f $(OBJ)\*.obj $(OBJ)\*.res
    -rm -f $(DLL)\ShadeBtn.dll $(DLL)\ShadeBtn.map $(DLL)\ShadeBtn.sym
    -rm -f $(DLL)\ShBtn.dll $(DLL)\ShBtn.map $(DLL)\ShBtn.sym
    -rm -f lib\ShadeBtn.lib
    -rm -f sample\Test1\Test1.exe sample\Test1\Test1.map sample\Test1\Test1.sym
    -rm -f sample\Test2\Test2.exe sample\Test2\Test2.map sample\Test2\Test2.sym
    -rm -f sample\Test3\Test3.exe sample\Test3\Test3.map sample\Test3\Test3.sym
    -rm -rf $(OBJ)
