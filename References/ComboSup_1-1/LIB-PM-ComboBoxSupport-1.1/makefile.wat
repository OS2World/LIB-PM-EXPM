# makefile.wat -- OpenWatcom wmake build for LIB-PM-ComboBoxSupport
# Target: 32-bit OS/2 (ArcaOS / Warp 4 flat model)
#
# Builds:
#   dll\combosup.dll  -- PM combo box support DLL (32-bit)
#   lib\combosup.lib  -- Import library (generated by wlink OPTION IMPLIB)
#   combosmp.exe      -- Sample PM application demonstrating the library
#
# Notes on the 16->32 bit conversion:
#   - EXPENTRY expands to _System in 32-bit os2.h; no source changes needed.
#   - halloc/hfree replaced with malloc/free (huge allocators not in 32-bit).
#   - Export names are mixed-case (InitComboBox, not INITCOMBOBOX) to match
#     the 32-bit _System convention.  The pre-built 16-bit lib\combosup.lib
#     is replaced by the freshly generated 32-bit one.
#   - combosmp.def WINDOWAPI/HEAPSIZE/STACKSIZE expressed as wlink options
#     (option moddef is not supported by wlink 2.0.1).
#
# Usage (run from the project root, where this file lives):
#   wmake -f makefile.wat           # build all
#   wmake -f makefile.wat clean     # remove all generated files

CC = wcc386

# -bd      build as DLL (defines __SW_BD, enables DLL runtime entry)
# -bt=os2  target OS/2 32-bit protected mode
# -zp1     1-byte struct packing (matches original -Zp)
# -w3      warning level 3
# -d__OS2__ explicit OS/2 guard macro
# wcc386 searches its own header directory automatically;
# only project-local headers need an explicit -i= flag.
CFLAGS_DLL = -bt=os2 -zp1 -w3 -bd -d__OS2__ -i=h
CFLAGS_EXE = -bt=os2 -zp1 -w3     -d__OS2__ -i=h

OBJ = obj
DLL = dll

# Create output directories before any recipe runs.
.BEFORE
    -mkdir $(OBJ) 2>NUL
    -mkdir $(DLL) 2>NUL

all: $(DLL)\combosup.dll sample\combosmp.exe .SYMBOLIC

# -----------------------------------------------------------------------
# DLL: dll\combosup.dll  (also produces lib\combosup.lib via OPTION IMPLIB)
# -----------------------------------------------------------------------

$(OBJ)\combosup.obj: src\combosup.c h\combosup.h
    $(CC) $(CFLAGS_DLL) -fo=$@ src\combosup.c

$(DLL)\combosup.dll: $(OBJ)\combosup.obj
    wlink &
        system os2v2 dll initinstance terminstance &
        name $(DLL)\combosup.dll &
        file $(OBJ)\combosup.obj &
        export InitComboBox &
        export InitComboBoxFromRcStrings &
        option implib=lib\combosup.lib &
        option map=$(DLL)\combosup.map

# -----------------------------------------------------------------------
# Sample EXE: combosmp.exe  (sources in sample/)
# Depends on $(DLL)\combosup.dll so wmake builds the DLL first;
# lib\combosup.lib is present as a side effect of that link step.
# sample\combosmp.def WINDOWAPI  -> system os2v2_pm
# sample\combosmp.def HEAPSIZE/STACKSIZE -> option heap/stack
# -----------------------------------------------------------------------

$(OBJ)\combosmp.obj: sample\combosmp.c sample\combosmp.h h\combosup.h
    $(CC) $(CFLAGS_EXE) -i=sample -fo=$@ sample\combosmp.c

$(OBJ)\combosmp.res: sample\combosmp.rc sample\combosmp.h
    wrc -r -bt=os2 -i=sample sample\combosmp.rc -fo=$@

sample\combosmp.exe: $(OBJ)\combosmp.obj $(OBJ)\combosmp.res $(DLL)\combosup.dll
    wlink &
        system os2v2_pm &
        name sample\combosmp.exe &
        file $(OBJ)\combosmp.obj &
        option stack=8192 &
        option heap=8192 &
        library lib\combosup.lib &
        option map=sample\combosmp.map
    wrc $(OBJ)\combosmp.res sample\combosmp.exe

# -----------------------------------------------------------------------
# Clean
# -----------------------------------------------------------------------

clean: .SYMBOLIC
    -rm -f $(OBJ)\*.obj $(OBJ)\*.res
    -rm -f $(DLL)\combosup.dll $(DLL)\combosup.map $(DLL)\combosup.sym
    -rm -f sample\combosmp.exe sample\combosmp.map sample\combosmp.sym
    -rm -f lib\combosup.lib
    -rm -rf $(OBJ)
